{
  /* TypeScript 编译器的主配置。 */
  "compilerOptions": {
    /* 将语法检查和输出目标对齐 ES2020。 */
    "target": "ES2020",
    /* 按照现代 JavaScript 规则处理 class 字段。 */
    "useDefineForClassFields": true,
    /* 使用 ES Module 模块语法。 */
    "module": "ESNext",
    /* 开启 ES2020、浏览器 DOM 和可迭代 DOM 类型。 */
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    /* 跳过 node_modules 中声明文件的类型检查，提升构建速度。 */
    "skipLibCheck": true,
    /* 模块解析：交由 Vite 这类打包器处理。 */
    "moduleResolution": "bundler",
    /* 允许 import 路径中显式使用 .ts 扩展名。 */
    "allowImportingTsExtensions": true,
    /* 允许直接 import JSON 文件。 */
    "resolveJsonModule": true,
    /* 确保每个文件都可以被 Vite 单独编译。 */
    "isolatedModules": true,
    /* TypeScript 只做类型检查，不生成 JavaScript，输出交给 Vite。 */
    "noEmit": true,
    /* 保留 JSX 语法，交由后续工具转换。 */
    "jsx": "preserve",
    /* 代码质量：开启严格类型和常见错误检查。 */
    "strict": true,
    /* 不允许声明后从未使用的局部变量。 */
    "noUnusedLocals": true,
    /* 不允许声明后从未使用的函数参数。 */
    "noUnusedParameters": true,
    /* 防止 switch case 意外穿透到下一个分支。 */
    "noFallthroughCasesInSwitch": true,
    /* 忽略 TypeScript 5.0 以前的已弃用配置警告。 */
    "ignoreDeprecations": "5.0",
    /* 从项目根目录解析非相对模块。 */
    "baseUrl": "./",
    /* 让 TypeScript 理解 Vite 中的 @ 路径别名。 */
    "paths": {
      "@": [
        "src"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  /* 只对 src 中的 TypeScript、TSX 和 Vue 文件做类型检查。 */
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  /* 同时引用 Vite 配置文件使用的 Node.js 类型项目。 */
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}